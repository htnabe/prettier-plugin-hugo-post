{
  "name": "@htnabe/prettier-plugin-hugo-post",
  "version": "0.0.1-rc.1",
  "description": "A Prettier plugin for formatting Hugo content files with YAML, TOML, or JSON front matter, Markdown content, and Go template syntax.",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "type": "module",
  "keywords": [
    "prettier",
    "plugin",
    "hugo",
    "markdown",
    "yaml",
    "toml",
    "json",
    "go-template",
    "front-matter",
    "static-site-generator"
  ],
  "author": "htnabe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/htnabe/prettier-plugin-hugo-post.git"
  },
  "bugs": {
    "url": "https://github.com/htnabe/prettier-plugin-hugo-post/issues"
  },
  "homepage": "https://github.com/htnabe/prettier-plugin-hugo-post#readme",
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.1.0"
  },
  "packageManager": "bun@1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "prettier": ">=3.0.0"
  },
  "dependencies": {
    "prettier-plugin-toml": "^2.0.6"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.10",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsdown",
    "example": "bun run build && bunx prettier --plugin ./dist/index.mjs examples/test.md"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "printWidth": 100,
    "bracketSpacing": true,
    "arrowParens": "avoid"
  },
  "allowScripts": {
    "lefthook@2.1.10": true
  }
}
