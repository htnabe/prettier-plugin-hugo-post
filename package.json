{
  "name": "@htnabe/prettier-plugin-hugo-post",
  "version": "0.0.3",
  "description": "A Prettier plugin for formatting Hugo content files with YAML, TOML, or JSON front matter, Markdown content, and Go template syntax.",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "type": "module",
  "keywords": [
    "prettier",
    "plugin",
    "hugo",
    "markdown",
    "front-matter"
  ],
  "author": "htnabe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/htnabe/prettier-plugin-hugo-post.git"
  },
  "bugs": {
    "url": "https://github.com/htnabe/prettier-plugin-hugo-post/issues"
  },
  "homepage": "https://github.com/htnabe/prettier-plugin-hugo-post#readme",
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.1.0"
  },
  "packageManager": "bun@1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "prettier": ">=3.0.0"
  },
  "dependencies": {
    "prettier-plugin-toml": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.0",
    "lefthook": "^2.2.2",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "prettier": "^3.10.1",
    "ts-node": "^10.9.2",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsdown",
    "example": "bun run build && bunx prettier --plugin ./dist/index.mjs --parser hugo-post < examples/test.md"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "printWidth": 100,
    "bracketSpacing": true,
    "arrowParens": "avoid"
  },
  "oxlint": {
    "plugins": [
      "typescript",
      "unicorn",
      "oxc"
    ],
    "categories": {
      "correctness": "error"
    },
    "rules": {
      "import/no-relative-parent-imports": "error"
    },
    "env": {
      "builtin": true
    },
    "options": {
      "typeAware": true,
      "typeCheck": true
    }
  }
}
